{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lukspa/open-decisions/main/schema/0.1.0/decision.schema.json",
  "title": "Open Decisions record 0.1.0",
  "description": "An immutable snapshot of a decision. See docs/specification.rst for semantic requirements beyond JSON Schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "revision", "time", "name", "kind", "status",
    "resource", "instrumentation_scope", "actors", "decision"
  ],
  "properties": {
    "schema_version": { "const": "0.1.0" },
    "id": { "$ref": "#/$defs/id" },
    "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "time": { "type": "string", "format": "date-time" },
    "observed_time": { "type": "string", "format": "date-time" },
    "name": { "$ref": "#/$defs/text" },
    "kind": { "enum": ["human", "automated", "ai", "hybrid"] },
    "status": { "enum": ["proposed", "decided", "deferred", "abstained", "failed"] },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service_name"],
      "properties": {
        "service_name": { "$ref": "#/$defs/text" },
        "service_namespace": { "$ref": "#/$defs/text" },
        "service_instance_id": { "$ref": "#/$defs/id" },
        "attributes": { "$ref": "#/$defs/attributes" }
      }
    },
    "instrumentation_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/text" },
        "version": { "$ref": "#/$defs/text" },
        "attributes": { "$ref": "#/$defs/attributes" }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "roles"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "enum": ["human", "service", "ai_agent", "organization"] },
          "roles": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["proposer", "decider", "reviewer", "executor", "observer"] }
          },
          "name": { "$ref": "#/$defs/text" },
          "version": { "$ref": "#/$defs/text" },
          "attributes": { "$ref": "#/$defs/attributes" }
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question", "options"],
      "properties": {
        "question": { "$ref": "#/$defs/text" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "label": { "$ref": "#/$defs/text" },
              "description": { "$ref": "#/$defs/text" },
              "attributes": { "$ref": "#/$defs/attributes" }
            }
          }
        },
        "selected_option_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        },
        "reason": { "$ref": "#/$defs/text" },
        "criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "description": { "$ref": "#/$defs/text" },
              "weight": { "type": "number", "minimum": 0, "maximum": 1 },
              "attributes": { "$ref": "#/$defs/attributes" }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "uri"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "uri": { "type": "string", "format": "uri" },
              "description": { "$ref": "#/$defs/text" },
              "media_type": { "$ref": "#/$defs/text" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}(?![\\s\\S])" },
              "attributes": { "$ref": "#/$defs/attributes" }
            }
          }
        },
        "confidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "method", "assessed_by"],
          "properties": {
            "value": { "type": "number", "minimum": 0, "maximum": 1 },
            "method": { "$ref": "#/$defs/text" },
            "assessed_by": { "$ref": "#/$defs/id" }
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": {
            "code": { "$ref": "#/$defs/text" },
            "message": { "$ref": "#/$defs/text" },
            "retryable": { "type": "boolean" }
          }
        }
      }
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "dependentRequired": { "span_id": ["trace_id"] },
      "properties": {
        "trace_id": { "type": "string", "pattern": "^(?!0{32})[0-9a-f]{32}(?![\\s\\S])" },
        "span_id": { "type": "string", "pattern": "^(?!0{16})[0-9a-f]{16}(?![\\s\\S])" },
        "correlation_id": { "$ref": "#/$defs/id" }
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision_id", "relationship"],
        "properties": {
          "decision_id": { "$ref": "#/$defs/id" },
          "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "relationship": { "enum": ["caused_by", "derived_from", "supersedes", "related_to"] },
          "attributes": { "$ref": "#/$defs/attributes" }
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invocations"],
      "properties": {
        "invocations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "actor_id", "purpose", "status", "provider", "model"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "actor_id": { "$ref": "#/$defs/id" },
              "purpose": { "enum": ["generation", "evaluation", "selection", "approval", "other"] },
              "status": { "enum": ["completed", "failed", "cancelled"] },
              "provider": { "$ref": "#/$defs/text" },
              "model": {
                "type": "object",
                "additionalProperties": false,
                "required": ["name"],
                "properties": {
                  "name": { "$ref": "#/$defs/text" },
                  "version": { "$ref": "#/$defs/text" },
                  "requested_name": { "$ref": "#/$defs/text" }
                }
              },
              "started_at": { "type": "string", "format": "date-time" },
              "ended_at": { "type": "string", "format": "date-time" },
              "parameters": { "$ref": "#/$defs/attributes" },
              "usage": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "input_tokens": { "$ref": "#/$defs/count" },
                  "output_tokens": { "$ref": "#/$defs/count" },
                  "cached_input_tokens": { "$ref": "#/$defs/count" },
                  "reasoning_output_tokens": { "$ref": "#/$defs/count" }
                }
              },
              "tools": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["id", "name", "status"],
                  "properties": {
                    "id": { "$ref": "#/$defs/id" },
                    "name": { "$ref": "#/$defs/text" },
                    "status": { "enum": ["completed", "failed", "cancelled"] },
                    "duration_ms": { "type": "number", "minimum": 0, "maximum": 9007199254740991 },
                    "attributes": { "$ref": "#/$defs/attributes" }
                  }
                }
              },
              "attributes": { "$ref": "#/$defs/attributes" }
            }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policies": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "result"],
            "properties": {
              "id": { "$ref": "#/$defs/id" },
              "version": { "$ref": "#/$defs/text" },
              "result": { "enum": ["pass", "fail", "unknown"] },
              "evidence_ids": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/id" }
              },
              "attributes": { "$ref": "#/$defs/attributes" }
            }
          }
        },
        "approvals": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor_id", "status"],
            "properties": {
              "actor_id": { "$ref": "#/$defs/id" },
              "status": { "enum": ["approved", "rejected", "pending"] },
              "time": { "type": "string", "format": "date-time" },
              "reason": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    },
    "attributes": { "$ref": "#/$defs/attributes" },
    "extensions": { "$ref": "#/$defs/attributes" }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "decided" } }, "required": ["status"] },
      "then": {
        "properties": {
          "decision": {
            "required": ["selected_option_ids"],
            "properties": { "options": { "minItems": 1 } }
          }
        }
      },
      "else": { "properties": { "decision": { "not": { "required": ["selected_option_ids"] } } } }
    },
    {
      "if": { "properties": { "status": { "const": "failed" } }, "required": ["status"] },
      "then": { "properties": { "decision": { "required": ["error"] } } },
      "else": { "properties": { "decision": { "not": { "required": ["error"] } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "ai" } }, "required": ["kind"] },
      "then": { "required": ["ai"] }
    }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]{0,255}(?![\\s\\S])" },
    "text": { "type": "string", "minLength": 1 },
    "count": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "attributes": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+(?![\\s\\S])",
        "maxLength": 256
      },
      "additionalProperties": { "$ref": "#/$defs/value" }
    },
    "value": {
      "type": ["string", "number", "boolean", "null", "array", "object"],
      "minimum": -9007199254740991,
      "maximum": 9007199254740991,
      "items": { "$ref": "#/$defs/value" },
      "additionalProperties": { "$ref": "#/$defs/value" }
    }
  }
}
